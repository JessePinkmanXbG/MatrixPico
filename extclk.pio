; Matrix Pico EXT_CLK engine (Xenon/Zephyr)
;
; Logic derived from Octal450's open-source EXT_CLK VHDL (15432, GliGli,
; Octal450) and confirmed by GHDL simulation of that VHDL. GPLv2.
;
; What the sim showed (post_proc.vhd):
;   - EXT_CLK_EN (to_slow/EXTC) asserts BEFORE the CPU reaches the signature
;     check, so the check executes on the slowed clock.
;   - the R_END timer is anchored on a fixed POST edge (post_cnt=24) and fires
;     the reset ~R_END/2 = 29501 STBY periods (48MHz) later.
; So the engine has TWO POST phases: count some pulses at full speed, assert
; EXT_CLK_EN, then count the rest up to the fixed anchor (now slowing), then
; time r_end off the anchor and pulse. post_count (phase 1) is swept to place
; the slowdown before the check; the anchor and r_end stay fixed.
;
; SET pins (base = CPU_RESET, count = 2):
;   bit 0 = CPU_RESET  (output=low glitch, input=float release; open-drain)
;   bit 1 = EXT_CLK_EN (push-pull output)
; POST on GPIO 28 (via fast diode + internal pull-up). STBY_CLK on GPIO 15.
;
; C pushes 6 values: post_count(phase1), phase2, r_end_coarse, pulse_width-1,
; fine, extc_hold.

.program extclk

	pull block                  ; x = post_count  (phase 1: full-speed pulses)
	mov x, osr
phase1_loop:
	wait 1 gpio 28
	wait 0 gpio 28
	jmp x-- phase1_loop

	set pins, 0b10              ; EXT_CLK_EN HIGH - slow the CPU BEFORE the check

	pull block                  ; x = phase2  (more pulses, now slowing, to the anchor)
	mov x, osr
	jmp !x anchor_done          ; phase2 == 0 -> already at the anchor
phase2_loop:
	wait 1 gpio 28
	wait 0 gpio 28
	jmp x-- phase2_loop
anchor_done:

	pull block                  ; x = r_end coarse (whole STBY periods)
	mov x, osr
	pull block                  ; y = pulse_width - 1
	mov y, osr

rend_delay:                     ; drift-free: count r_end STBY_CLK periods off the anchor
	wait 0 gpio 15
	wait 1 gpio 15
	jmp x-- rend_delay

	pull block                  ; x = fine (0-3 sys cycles, ~5ns each)
	mov x, osr
	jmp !x fire
fine_delay:
	jmp x-- fine_delay
fire:
	set pindirs, 0b11          ; reset -> output LOW (glitch); EXT_CLK_EN stays high
hold_rst:
	jmp y-- hold_rst
	set pindirs, 0b10          ; reset -> input FLOAT (open-drain release)

	pull block                  ; x = extc_hold
	mov x, osr
hold_extc:
	jmp x-- hold_extc

	set pins, 0b00             ; EXT_CLK_EN LOW
	push block
