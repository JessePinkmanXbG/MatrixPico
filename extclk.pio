; Matrix Pico EXT_CLK engine (Xenon/Zephyr)
;
; Logic derived from Octal450's open-source EXT_CLK VHDL (15432, GliGli,
; Octal450) and the RGH1.3 RP2040 reference. GPLv2 like the rest of the project.
;
; EXT_CLK differs from RGH 1.2:
;   - the slowdown point is CPU_EXT_CLK_EN, not CPU_PLL_BYPASS
;   - the reset pulse is very narrow (~2 cycles / ~10 ns) and the reset line
;     is PURE OPEN-DRAIN here: only ever pulled low, then released to float.
;     It is NEVER driven high, so no 3.3V ever reaches the 1.1V reset net.
;
; SET pins (base = CPU_RESET, count = 2):
;   bit 0 = CPU_RESET  (latch held 0; we switch DIRECTION: output=low, input=float)
;   bit 1 = EXT_CLK_EN (push-pull output)
; POST is read on GPIO 28 (needs a fast diode + internal pull-up on this
; board - 1.1V POST is below the RP2040 threshold). STBY_CLK on GPIO 15.
;
; The C side pushes 5 values: post_count, slow_delay, r_end, pulse_width-1,
; extc_hold.

.program extclk

	pull block                  ; x = post_count
	mov x, osr
	pull block                  ; y = slow_delay
	mov y, osr

wait_for_post_loop:
	wait 1 gpio 28
	wait 0 gpio 28
	jmp x-- wait_for_post_loop

slow_delay:
	jmp y-- slow_delay

	set pins, 0b10              ; EXT_CLK_EN HIGH, reset still floating

	pull block                  ; x = r_end
	mov x, osr
	pull block                  ; y = pulse_width - 1
	mov y, osr

	wait 1 gpio 28              ; anchor r_end on a POST rising edge (CPU-synchronous)

; r_end is now counted in STBY_CLK periods (GP15, ~48MHz, ~20.8ns each) instead
; of this chip's own cycles. Each loop blocks on one full STBY_CLK period, so the
; delay is LOCKED to the console's clock - no free-running drift over the ~0.6ms
; window. This is the whole point of EXT_CLK and what a free-running Pico lacked.
; At 200MHz sys / 48MHz STBY = ~4.16 instr-slots per period; this 3-instruction
; loop fits because each wait just blocks until its edge.
rend_delay:
	wait 0 gpio 15
	wait 1 gpio 15
	jmp x-- rend_delay

	set pindirs, 0b11          ; reset -> output -> LOW (glitch); EXT_CLK_EN stays high
hold_rst:
	jmp y-- hold_rst

	set pindirs, 0b10          ; reset -> input -> FLOAT (open-drain release, no 3.3V)

	pull block                  ; x = extc_hold
	mov x, osr
hold_extc:
	jmp x-- hold_extc

	set pins, 0b00             ; EXT_CLK_EN LOW
	push block
