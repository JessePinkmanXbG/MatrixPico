; Matrix Pico EXT_CLK engine (Zephyr) - FAITHFUL FSM PORT
;
; Constants are Octal450's ORIGINAL matrix-coolrunner-192mhz design (the Matrix V3):
;   R_END=118008 (Zephyr), R_LEN=2, post_rgh=24, delay_val=4475 (90nm) -> dwell
;   = 4475*4096 = 18,329,600 STBY periods (~382 ms). GHDL-confirmed mechanism.
;
; Sequence (works because the pre-check POST gap on this console is ~415 ms, so
; nothing POSTs during the ~382 ms dwell - post_cnt doesn't move, exactly as the
; parallel FSM assumes):
;   1. count post_count pulses up into the pre-check region.
;   2. wait one POST edge = reach the code before the long gap (post_cnt=23).
;   3. DWELL delay_val STBY periods inside that gap, CPU still full speed.
;   4. assert EXT_CLK_EN (slow the CPU), still inside the gap.
;   5. wait one POST edge = the now-slowed signature check (post_cnt=24).
;   6. time R_END STBY periods off that edge and pulse CPU_RESET.
;
; SET pins (base=CPU_RESET, count=2): bit0=CPU_RESET (open-drain glitch),
; bit1=EXT_CLK_EN (push-pull). POST=GP28 (diode+pull-up). STBY=GP15. Autopull(32).
; C pushes 6 values: post_count, dwell_periods, r_end_coarse, pulse_width-1,
; fine, extc_hold.

.program extclk

    out x, 32                   ; post_count (pulses into the pre-check region)
phase1_loop:
    wait 1 gpio 28
    wait 0 gpio 28
    jmp x-- phase1_loop

    wait 1 gpio 28              ; one more edge -> post_cnt=23 (code before the gap)

    out x, 32                   ; dwell_periods (slower.vhd delay_val, in STBY periods)
    jmp !x no_dwell
dwell_loop:                     ; wait inside the gap; CPU still full speed
    wait 0 gpio 15
    wait 1 gpio 15
    jmp x-- dwell_loop
no_dwell:

    set pins, 0b10             ; EXT_CLK_EN HIGH - slow the CPU, inside the gap

    wait 0 gpio 28             ; the now-slowed signature-check edge (post_cnt=24)

    out x, 32                   ; r_end coarse (STBY periods off the check edge)
    out y, 32                   ; pulse_width - 1
rend_delay:
    wait 0 gpio 15
    wait 1 gpio 15
    jmp x-- rend_delay

    out x, 32                   ; fine (0-3 sys cycles, ~5ns each)
    jmp !x fire
fine_delay:
    jmp x-- fine_delay
fire:
    set pindirs, 0b11          ; reset -> output LOW (glitch); EXT_CLK_EN stays high
hold_rst:
    jmp y-- hold_rst
    set pindirs, 0b10          ; reset -> input FLOAT (open-drain release)

    out x, 32                   ; extc_hold
hold_extc:
    jmp x-- hold_extc

    set pins, 0b00             ; EXT_CLK_EN LOW
    push block
