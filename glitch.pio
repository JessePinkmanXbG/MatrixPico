; Matrix Pico glitch program (RGH 1.2)
;
; Derived from PicoRGH by Balázs Triszka <balika011@gmail.com> (GPLv2).
; Timing sequence unchanged; reset-line drive changed for safety.
;
; This program is free software; you can redistribute it and/or modify it
; under the terms and conditions of the GNU General Public License,
; version 2, as published by the Free Software Foundation.
;
; SET pins (base = CPU_RESET, count = 2):
;   bit 0 = CPU_RESET  (output latch held at 0; we switch its DIRECTION)
;   bit 1 = PLL_BYPASS (normal push-pull output)
;
; Safety: the CPU reset line is a 1.1V net. The original program held it
; driven HIGH at 3.3V for the whole glitch window (most of a second per
; attempt). Here it is left floating (input / hi-Z) at all times except:
;   - the glitch pulse itself, where it is pulled LOW, and
;   - exactly ONE cycle of drive-high afterwards (RGH needs the line pulled
;     up immediately rather than drifting), then back to floating.
; At 192 MHz that one cycle is ~5 ns, mirroring what the Matrix CPLD does.
;
; POST is read on GPIO 28 (hard-coded below; keep in sync with main.c).

.program glitch

	pull block                  ; x = post_count
	mov x, osr
	pull block                  ; y = delay_to_pll
	mov y, osr

wait_for_post_loop:
	wait 1 gpio 28
	wait 0 gpio 28
	jmp x-- wait_for_post_loop

delay_pll:
	jmp y-- delay_pll

	set pins, 0b10              ; PLL bypass HIGH, reset still floating

	pull block                  ; x = delay_to_rst
	mov x, osr
	pull block                  ; y = glitch_width (C side passes width-1)
	mov y, osr

	wait 1 gpio 28

delay_rst:
	jmp x-- delay_rst

	set pindirs, 0b11           ; reset becomes output -> pulled LOW (glitch)
hold_rst:
	jmp y-- hold_rst

	set pins, 0b11              ; reset driven HIGH for one cycle only
	set pindirs, 0b10           ; reset back to floating
	set pins, 0b10              ; reset latch back to 0 (no effect while floating)

	pull block                  ; x = pll_hold
	mov x, osr
hold_pll:
	jmp x-- hold_pll

	set pins, 0b00              ; PLL bypass LOW
	push block                  ; tell the C side we're done
